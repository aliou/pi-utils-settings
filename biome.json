{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["@aliou/biome-plugins/configs/pi-coding-agent-extension"],
  "files": {
    "includes": ["**/*.ts", "**/*.json"],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noNonNullAssertedOptionalChain": "off"
          }
        }
      }
    }
  ]
}
